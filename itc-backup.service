# Nightly database backup. Install alongside itc-backup.timer:
#
#   cp itc-backup.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now itc-backup.timer
#   systemctl --user list-timers itc-backup.timer
#
# Not installed by default — adding a scheduler to someone's machine is their
# decision, not the repo's.
[Unit]
Description=ITC Events — database backup
After=itc-app.service

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace/projects/itc-app
EnvironmentFile=-%h/.openclaw/workspace/projects/itc-app/.env
ExecStart=%h/.openclaw/workspace/projects/itc-app/.venv/bin/python tools/backup.py
